{
	"name": "collect-ts",
	"version": "0.4.0",
	"laravelCollectionVersion": "13.10",
	"description": "TypeScript port of Laravel Collection (Laravel 13.x compatible) - fully typed",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/ovdlinden"
	},
	"scripts": {
		"prepare": "lefthook install",
		"build": "tsup && tsc -p tsconfig.build.json",
		"dev": "tsup --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
		"lint": "biome check src tests",
		"format": "biome format --write src tests",
		"coverage": "vitest run --coverage",
		"prepublishOnly": "npm run build",
		"docs:guides": "tsx scripts/generate-collection-guides.ts",
		"docs:icons": "bun run docs/scripts/vendor-icons.ts",
		"docs:lint": "bun run docs/scripts/lint-docs.ts",
		"docs:search": "tsx scripts/generate-search-index.ts",
		"docs:dev": "bun run docs:guides && bun run docs:search && bun run docs:icons && vitepress dev docs",
		"docs:build": "bun run docs:guides && bun run docs:search && bun run docs:lint && bun run docs:icons && vitepress build docs",
		"docs:preview": "vitepress preview docs",
		"docs:check": "tsx scripts/docs/index.ts check",
		"docs:sync": "tsx scripts/docs/index.ts sync",
		"pack": "pnpm build && pnpm pack",
		"validate": "publint && attw --pack --profile esm-only",
		"unused": "knip",
		"size": "size-limit",
		"size:check": "size-limit",
		"bench": "node --expose-gc --predictable ./node_modules/vitest/vitest.mjs bench",
		"bench:lazy": "node --expose-gc --predictable ./node_modules/vitest/vitest.mjs bench benchmarks/lazy.bench.ts",
		"bench:async": "node --expose-gc --predictable ./node_modules/vitest/vitest.mjs bench benchmarks/async-lazy.bench.ts",
		"bench:ci": "tsx scripts/benchmark-ci.ts",
		"bench:docs": "tsx docs/scripts/generate-benchmark-data.ts",
		"bench:check": "tsx scripts/check-benchmark-freshness.ts"
	},
	"keywords": [
		"laravel",
		"collection",
		"typescript",
		"collect",
		"array",
		"utilities",
		"enumerable",
		"groupby",
		"pluck",
		"where",
		"lodash-alternative",
		"functional",
		"chainable",
		"fluent",
		"data-transformation",
		"pipeline"
	],
	"author": "Omid van der Linden",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/ovdlinden/collect-ts"
	},
	"homepage": "https://github.com/ovdlinden/collect-ts#readme",
	"bugs": {
		"url": "https://github.com/ovdlinden/collect-ts/issues"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@babel/parser": "^8.0.4",
		"@babel/traverse": "^8.0.4",
		"@biomejs/biome": "^2.5.10",
		"@iconify-json/lucide": "^1.2.125",
		"@sebbo2002/semantic-release-jsr": "^4.0.2",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/exec": "^7.0.3",
		"@semantic-release/git": "^11.0.1",
		"@size-limit/file": "^13.0.3",
		"@types/babel__traverse": "^7.28.0",
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "^4.0.18",
		"knip": "^6.32.2",
		"lefthook": "^2.1.10",
		"markdown-it-container": "^4.0.0",
		"medium-zoom": "^1.1.0",
		"publint": "^0.3.24",
		"semantic-release": "^25.0.9",
		"size-limit": "^13.0.3",
		"terrastruct-d2-bin": "^0.7.1",
		"tsup": "^8.5.1",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vitepress": "2.0.0-alpha.19",
		"vitepress-plugin-group-icons": "^1.7.6",
		"vitepress-plugin-llms": "^1.13.5",
		"vitest": "^4.0.18",
		"vue": "^3.5.41"
	},
	"engines": {
		"node": ">=18"
	},
	"packageManager": "pnpm@9.15.1",
	"dependencies": {
		"minisearch": "^7.2.0"
	}
}
